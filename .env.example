# Copy this file to ".env" (same folder as docker-compose.yml). docker compose reads it automatically.
# The defaults in docker-compose.yml are placeholders for a local demo only.

# At least 32 characters, random. Signs the login tokens.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters

# Password for the three seeded users (admin, accountant, viewer).
SEED_PASSWORD=replace-with-a-real-password

# With true, the backend refuses to start while either value above is still a placeholder.
REQUIRE_STRONG_SECRETS=true
